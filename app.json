        "NSPhotoLibraryUsageDescription": "FitTrack 70 cần quyền Thư viện ảnh để chọn ảnh món ăn và phân tích dinh dưỡng."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
